# Supabase PostgreSQL
# For your current localhost/persistent Next.js server, use the Supavisor
# Session pooler URL (port 5432) for DATABASE_URL.
# Supabase Dashboard -> Connect -> Session pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres"

# Prisma CLI / schema operations. Use the Supabase Session pooler (5432)
# or the Direct connection URL when your network supports IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (uploaded images and videos) ---
# Dashboard -> Project Settings -> API. The URL and anon key are safe to expose;
# the service role key is server-only and must NEVER be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# One-time source database used by the migration script.
SOURCE_SQLITE_PATH="./db/custom.db"

# Generate your own values for any shared/staging environment.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars-long"
TOKEN_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-a-separate-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Images are normalized by the server, so they must fit Vercel's 4.5 MB
# serverless request body limit.
MAX_UPLOAD_MB=4
# Videos upload straight to Supabase Storage and bypass Vercel entirely.
# The Supabase Free plan rejects files above 50 MB; raise after upgrading.
MAX_VIDEO_UPLOAD_MB=50

# AI Provider (optional environment fallback). You can also configure this from
# SocialFlow → Settings → AI Provider, which stores the key encrypted.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
META_GRAPH_API_VERSION=v26.0
LINKEDIN_API_VERSION=202607

# Provider credentials — optional; blank providers remain unavailable.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/oauth/instagram/callback"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/oauth/facebook/callback"

THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
THREADS_REDIRECT_URI="http://localhost:3000/api/oauth/threads/callback"

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/oauth/linkedin/callback"

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/oauth/twitter/callback"

PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/oauth/pinterest/callback"

# Development-only fake channels. Keep false for a real deployment.
ALLOW_DEMO_SOCIAL_CONNECTIONS=false

# Optional transactional email
RESEND_API_KEY=""
EMAIL_FROM="SocialFlow <notifications@example.com>"

# Location suggestions in Composer (Geoapify Address Autocomplete)
# Create a free key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=""
# Optional: restrict results to one country, e.g. in, us, gb
LOCATION_SEARCH_COUNTRY_CODE=""
# Optional Geoapify bias, e.g. proximity:73.8567,18.5204 for Pune
LOCATION_SEARCH_BIAS=""
